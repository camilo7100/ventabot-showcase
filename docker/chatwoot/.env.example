# Configuracion de Chatwoot para correr EN EL PC.
# Copia este archivo a .env (en esta misma carpeta) antes de levantarlo.

# Una clave larga y aleatoria. Generala con:
#     python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY_BASE=CAMBIAME_POR_UNA_CLAVE_LARGA

# Desde donde se abre. En el PC, esto.
FRONTEND_URL=http://localhost:3000

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true

POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=chatwoot_local

REDIS_URL=redis://:chatwoot_local@redis:6379

# Sin correo: en local no hace falta y pedirlo bloquea la instalacion.
# Si un dia quieres que mande avisos por email, se llena esto.
MAILER_SENDER_EMAIL=lia@localhost
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Nadie mas se puede registrar: es el PC de Lía, no un servicio publico.
ENABLE_ACCOUNT_SIGNUP=false

# Chatwoot 4.x no entrega webhooks a direcciones privadas (proteccion SSRF) y
# el bot corre en este mismo PC: sin esto, del CRM no vuelve nada al bot.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
