# ==========================================================================
# Copia a .env y llena.  cp .env.example .env
# NUNCA subas .env a Git (ya está en .gitignore, y hay un test que lo vigila).
#
# ⚠️ REGLA DE FORMATO: los comentarios van SIEMPRE en su propia línea.
#    `CLAVE=            # comentario`  hace que el valor SEA el comentario.
#    Es un error silencioso y confuso; por eso aquí no se usa esa forma nunca.
# ==========================================================================

# --------------------------------------------------------------------------
# Selección de implementaciones — aquí es donde "migras" de backend.
#   REPOSITORY_BACKEND: memory | sqlite | sheets | sql | sap
#   LLM_BACKEND:        fake | ollama | claude
#   PAYMENT_BACKEND:    fake | bold | wompi
# --------------------------------------------------------------------------
ENTORNO=dev
# sqlite guarda los pedidos en disco: sobreviven a reiniciar el servidor.
# memory es solo para tests y demos — ahi se pierde todo al cerrar.
REPOSITORY_BACKEND=sqlite
LLM_BACKEND=fake
# Quién conversa con la clienta (ADR 0014):
#   asesora  = la IA (GPT, con Claude de respaldo) lee la conversación y propone;
#              Python valida y ejecuta. LLM_BACKEND=claude quiere decir «IA en
#              línea» (el nombre es histórico) y necesita ANTHROPIC_API_KEY.
#   pipeline = el gestor por etiquetas de siempre
CONVERSACION_MOTOR=asesora
# Excel de ventas que se actualiza solo (ADR 0015). Vacío = Documentos\Luna Joyas.
# Columnas verdes = tuyas (vuelven a la base); grises = del sistema.
VENTAS_EXCEL=
# Cada cuántos segundos se revisa si hay que actualizarlo. 0 = apagado.
VENTAS_CADA_S=120
PAYMENT_BACKEND=fake

# --------------------------------------------------------------------------
# Panel del taller (lo que abre Lía en el celular para mover los pedidos)
#
# VACIO = panel APAGADO, y esa es la opcion segura por defecto. El panel
# muestra nombres, telefonos y montos de clientas reales, y el servidor se
# publica por un tunel al internet abierto.
#
# Para encenderlo, pon aqui una cadena larga y aleatoria. Generala con:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Luego se entra a:  https://TU-URL-DE-NGROK/panel?token=EL_TOKEN
# Ese enlace se puede guardar como acceso directo en la pantalla de inicio.
# Trata el enlace como una contrasena: quien lo tenga, ve todos los pedidos.
# --------------------------------------------------------------------------
PANEL_TOKEN=

# URL publica desde la que Meta baja las fotos del anillo.
# Es la de ngrok (o tu dominio real). Los servidores de Meta hacen un GET
# desde internet: "localhost" no existe para ellos.
# La escribe sola el comando: vb panel
# Normalmente se deja VACIA: cae sola sobre PUBLIC_URL (el tunel de ngrok).
# Solo se pone si las fotos y los videos se sirven desde otra direccion.
URL_PUBLICA=

# CHANNEL_BACKEND decide DONDE salen las respuestas del bot:
#   console  -> se imprimen en la ventana del servidor (para probar sin Meta)
#   whatsapp -> se envian de verdad por WhatsApp
# Empieza en console. Pasa a whatsapp solo cuando el flujo ya te funcione.
CHANNEL_BACKEND=console

# --------------------------------------------------------------------------
# Meta / WhatsApp Cloud API           (guía: docs/FASE_0_SETUP.md §2)
#
# El número NO puede estar activo en la app de WhatsApp normal ni Business.
# El display name debe coincidir EXACTAMENTE con tu sitio web, y solo se puede
# cambiar cada 30 días.
# WA_ACCESS_TOKEN: usa un System User token permanente, no el temporal de 24 h.
# META_APP_SECRET: es lo que verifica la firma X-Hub-Signature-256.
# META_VERIFY_TOKEN: lo inventas TÚ; Meta te lo devuelve en el handshake GET.
# --------------------------------------------------------------------------
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --------------------------------------------------------------------------
# Instagram (Fase 5)
#
# Usa "Instagram API con Instagram Login": NO requiere Página de Facebook.
# Con Standard Access (tu propia cuenta) te ahorras todo el App Review.
# --------------------------------------------------------------------------
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --------------------------------------------------------------------------
# Pasarela de pago                    (guía: docs/FASE_0_SETUP.md §4)
# No hace falta hasta la Fase 3, pero el registro tarda: arráncalo desde ya.
# --------------------------------------------------------------------------
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
BOLD_CALLBACK_URL=

# Alternativa Wompi (deja Bold vacío si usas esta)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENT_SECRET=

# --------------------------------------------------------------------------
# Túnel HTTPS público                 (guía: docs/FASE_0_SETUP.md §3)
# Meta exige HTTPS con certificado válido para los webhooks.
#   ngrok http 8000     |     cloudflared tunnel --url http://localhost:8000
# --------------------------------------------------------------------------
PUBLIC_URL=

# --------------------------------------------------------------------------
# CÓMO CONTESTA
#
# Segundos que espera por si la clienta sigue escribiendo, para contestarle
# TODO de una vez en lugar de mensaje por mensaje. Así escriben de verdad:
#
#     «Son dos huellitas»
#     «Una huellita negra por mi panterita»
#     «Y la otra huellita no se jajaja»
#
# Tres mensajes que son UNA pregunta. Es la CALMA que se espera (cada
# mensaje nuevo la reinicia), con un tope desde el primero. El primer mensaje
# de una conversación no espera. En producción: 20 y 60 (docker-compose.yml).
# --------------------------------------------------------------------------
AGRUPAR_SEGUNDOS=20
AGRUPAR_TOPE_SEGUNDOS=60

# La talla la confirma Lía en el panel antes del abono (en producción: true).
TALLA_LA_CONFIRMA_LIA=true

# --------------------------------------------------------------------------
# LOS DOS PROVEEDORES DE IA (29/09). En producción: GPT primero y Anthropic de
# respaldo (docker-compose.yml). Si el primero no contesta, el otro, en vueltas.
#   IA_PRINCIPAL:          anthropic | openai  (quién va primero)
#   LLM_RESPALDO_BACKEND:  vacío = un solo proveedor; openai = sumar GPT
#   OPENAI_ESFUERZO:       cuánto razona (none, low, medium…); vacío = el de fábrica
# --------------------------------------------------------------------------
# Cuántos segundos se insiste dentro del turno (uno, el otro, uno…). Después el
# turno queda pendiente y se reintenta solo hasta que alguno vuelva.
IA_PACIENCIA_S=35
IA_PRINCIPAL=openai
LLM_RESPALDO_BACKEND=openai
# NUNCA en el código ni en GitHub: solo en el .env.
OPENAI_API_KEY=
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=none
OPENAI_MODELO_FUERTE=gpt-6-luna
OPENAI_ESFUERZO_FUERTE=low

# --------------------------------------------------------------------------
# CLAUDE (Anthropic): el respaldo de GPT (ADR 0027)
#
#   mensaje -> reglas de Python (sin IA) -> modelo BASICO -> modelo POTENTE
#
# El potente NO entra por numero de mensajes: entra por un motivo auditable
# (no se entendio nada, el basico dijo confianza BAJA, una accion sensible, o
# una foto que importa y no se entendio). Ver docs/ARQUITECTURA_CONTEXTO.md.
# El proveedor se elige por el NOMBRE: claude-* = Anthropic.
# --------------------------------------------------------------------------
LLM_BASICO_MODEL=claude-haiku-5-5
LLM_FUERTE_MODEL=claude-sonnet-5-5
# El Claude de las fotos (GPT va delante). Vacio = nadie las lee: se marcan
# para que las mire una persona.
LLM_VISION_MODEL=claude-haiku-5-5
# NUNCA en el codigo: una clave en un commit se queda en el historial de Git
# para siempre, aunque la borres en el commit siguiente.
ANTHROPIC_API_KEY=

# Cuantas horas atras cuentan como contexto RECIENTE para el modelo potente.
# Mensajes mas viejos (otro dia, otro anillo) contaminan en vez de ayudar.
VENTANA_RECIENTE_HORAS=12

# Guarda en SQLite por que se decidio cada turno: capa, confianza, contexto,
# historial, costo. SIN textos ni telefonos. Lo lee `vb metricas`.
REGISTRAR_DECISIONES=true

# Ollama (modelo local): VentaBot NO lo usa (solo modelos en linea). Queda
# solo para LLM_BACKEND=ollama en experimentos; no se enciende en produccion.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_NUM_CTX=16384

# --------------------------------------------------------------------------
# Google Sheets (Fase 2)
# Recuerda COMPARTIR la hoja con el email de la service account
# (...@....iam.gserviceaccount.com). Es el paso que todo el mundo olvida.
# --------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=
# Cada cuánto se pone al día el ERP aunque nadie mueva un pedido (segundos).
ERP_CADA_S=600
# Desde qué día (AAAA-MM-DD) las ventas del bot son de verdad. Vacío = todo lo
# del bot es de prueba y el panel de marketing lo dice así. Se pone el día de
# «Pasar a real» (INSTRUCTIVO §10).
VENTAS_REALES_DESDE=

# --------------------------------------------------------------------------
# Infraestructura (Fase 6)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://ventabot:ventabot@localhost:5432/ventabot
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# Observabilidad (Fase 6) — elige uno
# --------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Vacio = la nube de LangSmith. Con un LangSmith propio: http://localhost:1984
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=ventabot
LANGFUSE_HOST=

# --- CRM (Chatwoot) -------------------------------------------------------
# Vacio = no se copia nada y el bot funciona igual.
# Levantalo con:  vb chatwoot
CHATWOOT_URL=
# Por donde entra Lía a Chatwoot desde internet (enlaces del panel). Vacio =
# la misma direccion publica del bot. En el servidor: https://chat.lunajoyas.example
CHATWOOT_URL_PUBLICA=
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=0
# Lo que protege /webhook/chatwoot, por donde entra lo que escribes desde la
# bandeja para que le salga a la clienta. Vacio = ese webhook no existe.
CHATWOOT_WEBHOOK_TOKEN=
# Token del agente bot «VentaBot»: lo que copia el bot sale firmado por él (no
# a nombre de Lía) y así se reconoce su eco. Lo pone vb chatwoot --conectar.
CHATWOOT_BOT_TOKEN=
# A quien se le asigna en Chatwoot lo que contestas desde el PANEL (el panel
# no sabe quien escribe): el numero de la persona en Chatwoot (Lía). 0 = a
# nadie, el bot solo se calla.
CHATWOOT_PERSONA_DEL_PANEL=0

# --------------------------------------------------------------------------
# NOTAS DE VOZ
# --------------------------------------------------------------------------
# Muchas clientas hablan en vez de escribir. Sin esto, el bot les pide que lo
# escriban y ahi se pierde gente. Con "groq" se transcriben (~USD 0,04 por hora
# de audio, y la capa gratis alcanza de sobra para este volumen).
#   ninguno | groq
TRANSCRIPCION_BACKEND=ninguno
GROQ_API_KEY=
GROQ_MODELO_AUDIO=whisper-large-v3-turbo

# --------------------------------------------------------------------------
# AVISOS AL CELULAR (cuando algo se rompe)
# --------------------------------------------------------------------------
# Lo que mas duele no es que el bot falle: es que falle y nadie se entere.
# "ntfy" no necesita cuenta: instala la app ntfy en el celular, suscribete al
# tema de abajo y listo. Que el tema sea largo y dificil de adivinar.
#   ninguno | ntfy | telegram
AVISOS_BACKEND=ninguno
NTFY_TEMA=
NTFY_SERVIDOR=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------------------
# RECORDATORIOS (antes del abono)
# --------------------------------------------------------------------------
# A quien se quedo a medias ANTES del abono (talla, colores, grabado, resumen,
# abono) y escribio al menos dos mensajes: el de su etapa y otro si cabe antes
# de que se cierren sus 24 h, SOLO a las 9 a. m. o a las 5 p. m. Nunca si dijo que no,
# si la atiende una persona o si esta escalada. Reglas y horas:
# app/domain/recordatorios.py. Lo que haria ahora, sin mandar nada:
# vb recordatorios. APAGADO de fabrica.
RECORDATORIOS=false
RECORDATORIOS_CADA_S=300
# El tercero, a los 3 dias, con la plantilla de Meta `retomar_diseno` (solo a
# quien ya avanzo en su diseno, una vez por semana como mucho). Enciendelo
# SOLO cuando `vb recordatorios --plantilla` diga APPROVED.
RECORDATORIO_CON_PLANTILLA=false
# Como se programan (13/10): "dias" = por segmentos (S1-S4) y dias, de 10 a. m.
# a 7 p. m., con foto y botones (app/domain/recordatorios_por_dias.py; las 4
# plantillas: vb recordatorios --plantillas). "horarios" = el de antes (9 y 5).
RECORDATORIOS_MODO=dias

# --------------------------------------------------------------------------
# LA VENTA A META Y LA PRUEBA DE LA APERTURA (13/10)
# --------------------------------------------------------------------------
# El dataset de MENSAJES de la cuenta de WhatsApp del bot: cada abono
# confirmado va ahi como `Purchase`, unido al clic del anuncio. Vacio = nada.
META_DATASET_MENSAJES=
# A «Quiero mas informacion» se le abre con la foto de un anillo grabado y
# «¿Como se llama tu peludito?»; los precios van en su segundo mensaje.
APERTURA_PELUDITO=false

# --------------------------------------------------------------------------
# SERVIDOR EN LA NUBE (docker compose)
# --------------------------------------------------------------------------
# Para el perfil "ngrok": tu authtoken (dashboard.ngrok.com > Your Authtoken).
# Con el mismo PUBLIC_URL de siempre, Meta no nota la mudanza.
NGROK_AUTHTOKEN=
# Para el perfil "tunel" (Cloudflare, con dominio propio).
CLOUDFLARE_TUNNEL_TOKEN=
